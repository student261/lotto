# ==============================================================================
# Jackpotlo Environment Configuration Template
# Copy this file to .env for local development or set these variables in Railway
# ==============================================================================

# Node Environment & Port (Railway sets PORT automatically)
NODE_ENV=production
PORT=3001

# ------------------------------------------------------------------------------
# Option A: Single Connection String (Recommended for Railway MySQL)
# Railway automatically provisions MYSQL_URL or DATABASE_URL when you add MySQL.
# Example: mysql://root:password@roundhouse.proxy.rlwy.net:12345/railway
# ------------------------------------------------------------------------------
# MYSQL_URL=mysql://user:password@host:port/database
# DATABASE_URL=mysql://user:password@host:port/database

# ------------------------------------------------------------------------------
# Option B: Individual MySQL Connection Parameters
# Used if MYSQL_URL is not set or for local XAMPP / MySQL installation
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lotto_pos

# ------------------------------------------------------------------------------
# Platform Administrator Provisioning Secret
# Used to securely bootstrap or reset administrator credentials on the deployed cloud host:
# POST /api/admin/provision with header "x-admin-provision-key: <ADMIN_PROVISION_KEY>"
# ------------------------------------------------------------------------------
ADMIN_PROVISION_KEY=replace_with_a_long_random_secret_key_for_production

# Optional: CORS Origin restriction (defaults to open or client domain)
# CORS_ORIGIN=https://your-jackpotlo-site.netlify.app


# ------------------------------------------------------------------------------
# Public site address (used in email links). Never derived from request headers.
# ------------------------------------------------------------------------------
PUBLIC_SITE_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Payments: Polar ($179 one-time lifetime license)
# Token scopes: checkouts:read, checkouts:write, orders:read, products:read
# ------------------------------------------------------------------------------
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_SERVER=production
# Local only: fake payment button when no gateway is configured
# ALLOW_LOCAL_TEST_PAYMENT=true

# ------------------------------------------------------------------------------
# Transactional email: Brevo (password reset + welcome email)
# Key permission: Transactional email = All. Sender must be verified in Brevo.
# ------------------------------------------------------------------------------
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=LottoTrack Pro
